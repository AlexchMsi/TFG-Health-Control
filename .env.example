# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=gea
INFLUXDB_BUCKET=health_status
INFLUXDB_ADMIN_TOKEN=change-me-in-production
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_SERVER_ROOT_URL=http://localhost:3000

# ── Server Agent ──────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# ── VMware / vSphere ──────────────────────────────────────────────────────────
VMWARE_HOST=vcenter.example.com
VMWARE_USER=readonly@vsphere.local
VMWARE_PASSWORD=change-me
VMWARE_IGNORE_SSL=false

# ── SNMP ──────────────────────────────────────────────────────────────────────
SNMP_COMMUNITY=public
SNMP_VERSION=2c

# ── WinRM (optional enhanced collection) ──────────────────────────────────────
WINRM_USER=
WINRM_PASSWORD=
WINRM_TRANSPORT=ntlm

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
